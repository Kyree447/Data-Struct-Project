    public static void benchmarkingList(String name, List <PatientRecord> list, List<PatientRecord> records){
        long start, end;

        start = System.nanoTime();
        for(PatientRecord r : records){
            if(name.equals("ArrayList"))insertArrayList(list, r);
            else insertLinkedList(list, r);
        }
        end = System.nanoTime();
        System.out.println(name + "Insert Time: " +(end - start)+ " ns");

        System.out.println("--- Traversing " + name + " ---");
        if (name.equals("ArrayList")) traverseArrayList(list);
        else traverseLinkedList(list);

        int searchId = records.get(new Random().nextInt(records.size())).id;
        start = System.nanoTime();
        PatientRecord found = (name.equals("ArrayList")) ? searchArrayList(list, searchId) : searchLinkedList(list, searchId);
        end = System.nanoTime();
        System.out.println(name + " Search Time: " + (end - start) + " ns");
        System.out.println("Found record: " + (found != null ? found : "None"));
    }
    public static void benchmarkMap(Map<Integer, PatientRecord> map, List<PatientRecord> records) {
        long start, end;

        start = System.nanoTime();
        for (PatientRecord r : records) {
            insertHashMap(map, r);
        }
        end = System.nanoTime();
        System.out.println("HashMap Insert Time: " + (end - start) + " ns");

        System.out.println("--- Traversing HashMap ---");
        traverseHashMap(map);

        int searchId = records.get(new Random().nextInt(records.size())).id;
        start = System.nanoTime();
        PatientRecord found = searchHashMap(map, searchId);
        end = System.nanoTime();
        System.out.println("HashMap Search Time: " + (end - start) + " ns");
        System.out.println("Found record: " + (found != null ? found : "None"));

        start = System.nanoTime();
        boolean deleted = deleteHashMap(map, searchId);
        end = System.nanoTime();
        System.out.println("HashMap Delete Time: " + (end - start) + " ns");
        System.out.println("Deleted record with ID " + searchId + ": " + deleted);
        System.out.println();
    }
