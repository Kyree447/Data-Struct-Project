    public static void insertQueue(Queue<PatientRecord> queue, PatientRecord record) {
        queue.offer(record);
    }

    public static PatientRecord searchQueue(Queue<PatientRecord> queue, int id) {
        for (PatientRecord r : queue) {
            if (r.id == id) return r;
        }
