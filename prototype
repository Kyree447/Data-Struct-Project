class PatientRecord {
    int id;
    int age;
    String gender;
    String hospital;
    String medicalCondition;
    String admissionType;
    double billingAmount;

    public PatientRecord(int id, int age, String gender, String medicalCondition, String hospital, String admissionType, double billingAmount){
        this.id = id;
        this.age = age;
        this.gender = gender;
        this.medicalCondition = medicalCondition;
        this.hospital = hospital;
        this.admissionType = admissionType;
        this.billingAmount = billingAmount;
    }
    @Override
    public String toString() {
        return "ID: "+id+ "| age: "+age+ "| Gender : "+gender+ " | Condition: "+ medicalCondition + "| Hospital: " + hospital + " | Admission Type: "+ admissionType + " | Billing : $" +billingAmount;

    }
}
class HealthcareDataStructuresSimple {

    public static List<PatientRecord> loadDataset(String fileName) {
        List<PatientRecord> records = new ArrayList<>();
        try (BufferedReader br = new BufferedReader(new FileReader(fileName))) {
            String line;
            int uniqueId = 1;
            br.readLine();
            while ((line = br.readLine()) != null) {
                String[] fields = line.split(",");
                if (fields.length < 7) continue;
                try {
                    int age = Integer.parseInt(fields[1].trim());
                    String gender = fields[2].trim();
                    String medicalCondition = fields[3].trim();
                    String hospital = fields[4].trim();
                    String admissionType = fields[5].trim();
                    double billingAmount = Double.parseDouble(fields[6].trim());
                    records.add(new PatientRecord(uniqueId++, age, gender, medicalCondition,
                            hospital, admissionType, billingAmount));
                } catch (NumberFormatException e) {

                }
            }
        } catch (IOException e) {
            System.err.println("Error reading file: " + e.getMessage());
        }
        return records;
    }
    public static void insertLinkedList(List<PatientRecord> list, PatientRecord record) {
        list.add(record);
    }

    public static PatientRecord searchLinkedList(List<PatientRecord> list, int id) {
        for (PatientRecord r : list) {
            if (r.id == id) return r;
        }
        return null;
    }

    public static boolean deleteLinkedList(List<PatientRecord> list, int id) {
        return list.removeIf(r -> r.id == id);
    }

    public static void traverseLinkedList(List<PatientRecord> list) {
        for (PatientRecord r : list) {
