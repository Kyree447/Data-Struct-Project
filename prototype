     private double calculateBilling(String condition) {
         String c = condition.toLowerCase();
         if (c.contains("emergency")) return 1000.0;
         if (c.contains("flu")) return 200.0;
         if (c.contains("injury")) return 500.0;
         if (c.contains("elective")) return 300.0;
         return 400.0; // default billing
     }

     private int calculateWaitTime(String condition) {
         String c = condition.toLowerCase();
         if (c.contains("emergency") || c.contains("flu")) return 5;
         if (c.contains("injury")) return 20;
         return 45; // Default wait time
     }

    private void displayPatientInfo() {
        try {
            int age = Integer.parseInt(ageField.getText().trim());
            String gender = genderField.getText().trim();
            String condition = conditionField.getText().trim();
            String hospital = hospitalField.getText().trim();
            String type = admissionTypeField.getText().trim();

            // Calculate billing automatically
            double billing = calculateBilling(condition);

            PatientRecord newPatient = new PatientRecord(new Random().nextInt(1000), age, gender, condition, hospital, type, billing);
            int waitTime = calculateWaitTime(condition);
            long startTime=System.nanoTime();
            long endTime = System.nanoTime();
            long duration = endTime - startTime;


            outputArea.setText("--- PATIENT REGISTERED ---\n" + newPatient.toString() +
                    "\nESTIMATED WAIT TIME: " + waitTime + " Minutes\n" +
                    "BILLING AMOUNT: $" + String.format("%.2f", billing)+ "\n\n" +
                    "Processing Time: " + duration + " ns");


        } catch (NumberFormatException ex) {
            JOptionPane.showMessageDialog(this, "Please enter valid numeric values for Age and Billing.", "Input Error", JOptionPane.ERROR_MESSAGE);
        }
    }

